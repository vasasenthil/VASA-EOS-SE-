# ============================================================================
# VASA-EOS-SE-TN Environment Configuration
# ============================================================================
# Copy this file to `.env.local`, `.env.production`, or your deployment secret
# manager and fill in the values. Never commit real secrets.
#
# [REQUIRED]    Must be set before production cutover.
# [RECOMMENDED] Strongly advised for operations and incident response.
# [OPTIONAL]    Feature or provider-specific tuning.
# ============================================================================

# ----------------------------------------------------------------------------
# RUNTIME MODE / SAFETY
# ----------------------------------------------------------------------------
NODE_ENV=production
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_DEMO_MODE=false
# [REQUIRED] Leave DEMO_PASSWORD unset in production; cutover blocks if set.
# DEMO_PASSWORD=

# ----------------------------------------------------------------------------
# SUPABASE / POSTGRES DATA PLANE [REQUIRED]
# ----------------------------------------------------------------------------
# Create a project at https://supabase.com
# SUPABASE_* names are operator-friendly aliases; NEXT_PUBLIC_* names are consumed
# by the Next.js app and browser auth code.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<supabase-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase-anon-key>
DATABASE_URL=postgres://<user>:<password>@<host>:5432/<database>?sslmode=require
SUPABASE_DB_URL=postgres://<user>:<password>@<host>:5432/<database>?sslmode=require

# ----------------------------------------------------------------------------
# PFMS INTEGRATION [REQUIRED for scholarship disbursement]
# ----------------------------------------------------------------------------
# Apply for API access at https://pfms.nic.in
# See docs/setup/credentials-guide.md for instructions.
INTEGRATION_PFMS=mock
PFMS_BASE_URL=https://<pfms-gateway>
PFMS_API_KEY=<pfms-api-key-or-token>
PFMS_API_SECRET=<pfms-hmac-secret>
PFMS_HMAC_ALGORITHM=SHA256
PFMS_TIMEOUT_MS=30000
PFMS_MAX_RETRIES=3

# ----------------------------------------------------------------------------
# DBT/APBS INTEGRATION [REQUIRED for scholarship payment settlement]
# ----------------------------------------------------------------------------
INTEGRATION_DBT=mock
DBT_BASE_URL=https://<dbt-apbs-gateway>
DBT_API_KEY=<dbt-apbs-api-key-or-token>
DBT_TIMEOUT_MS=30000
DBT_MAX_RETRIES=3

# ----------------------------------------------------------------------------
# APAAR INTEGRATION [REQUIRED for student ID provisioning]
# ----------------------------------------------------------------------------
# Register through the official APAAR / MoE onboarding route.
INTEGRATION_APAAR=mock
APAAR_BASE_URL=https://<apaar-gateway>
APAAR_API_KEY=<apaar-api-key-or-token>
APAAR_TIMEOUT_MS=30000

# ----------------------------------------------------------------------------
# DIGILOCKER INTEGRATION [REQUIRED for document issuance]
# ----------------------------------------------------------------------------
# Register at https://www.digilocker.gov.in
INTEGRATION_DIGILOCKER=mock
DIGILOCKER_BASE_URL=https://<digilocker-partner-gateway>
DIGILOCKER_API_KEY=<digilocker-oauth-token-or-api-key>
DIGILOCKER_CLIENT_ID=<digilocker-client-id>
DIGILOCKER_CLIENT_SECRET=<digilocker-client-secret>
DIGILOCKER_REDIRECT_URI=https://<platform-domain>/api/integrations/digilocker/callback
DIGILOCKER_TIMEOUT_MS=30000

# ----------------------------------------------------------------------------
# BHASHINI INTEGRATION [REQUIRED for translation/TTS]
# ----------------------------------------------------------------------------
# Apply at https://bhashini.gov.in
INTEGRATION_BHASHINI=mock
BHASHINI_INFERENCE_URL=https://<bhashini-inference-pipeline>
BHASHINI_API_KEY=<bhashini-api-key>
BHASHINI_USER_ID=<bhashini-user-id>
BHASHINI_TRANSLATION_SERVICE_ID=<translation-service-id>
BHASHINI_TTS_SERVICE_ID=<tts-service-id>
BHASHINI_ASR_SERVICE_ID=<asr-service-id>
BHASHINI_TIMEOUT_MS=60000

# ----------------------------------------------------------------------------
# NDEAR INTEGRATION [REQUIRED for standards compliance]
# ----------------------------------------------------------------------------
# Access via https://www.ndear.gov.in
INTEGRATION_NDEAR=mock
NDEAR_BASE_URL=https://<ndear-or-state-gateway>
NDEAR_API_KEY=<ndear-api-key-or-token>
NDEAR_TIMEOUT_MS=30000

# ----------------------------------------------------------------------------
# OTHER PHASE 6 / PLATFORM INTEGRATIONS [OPTIONAL until enabled]
# ----------------------------------------------------------------------------
INTEGRATION_AADHAAR=mock
AADHAAR_BASE_URL=https://<aua-kua-gateway>
AADHAAR_API_KEY=<aadhaar-gateway-api-key>

INTEGRATION_UDISE=mock
UDISE_BASE_URL=https://<udise-gateway>
UDISE_API_KEY=<udise-api-key-if-required>

INTEGRATION_DIKSHA=mock
DIKSHA_BASE_URL=https://diksha.gov.in

INTEGRATION_EMIS=mock
EMIS_BASE_URL=https://<tn-emis-gateway>
EMIS_API_KEY=<emis-api-key>

INTEGRATION_TNPORTAL=mock
TNPORTAL_BASE_URL=https://<tn-schools-portal-gateway>
TNPORTAL_API_KEY=<tn-portal-api-key>

INTEGRATION_EXAMS=mock
EXAMS_BASE_URL=https://<dge-exam-system-gateway>
EXAMS_API_KEY=<exam-system-api-key>

INTEGRATION_RETRIEVAL=mock
RETRIEVAL_BASE_URL=https://<retrieval-vector-gateway>
RETRIEVAL_API_KEY=<retrieval-api-key>

INTEGRATION_AGENTS=mock
AGENTS_API_URL=https://api.openai.com/v1/chat/completions
AGENTS_API_KEY=<llm-or-agent-gateway-api-key>
AGENTS_MODEL=<approved-model-id>

# ----------------------------------------------------------------------------
# WORKER ENABLEMENT [REQUIRED for production]
# ----------------------------------------------------------------------------
# ENABLE_* names are operator-facing; *_WORKER_ENABLED names are consumed by the
# current cutover gate and worker manifests.
ENABLE_OUTBOX_DISPATCHER_WORKER=true
ENABLE_SLA_MONITOR_WORKER=true
ENABLE_DRIFT_MONITOR_WORKER=true
ENABLE_RETRAINING_ORCHESTRATOR_WORKER=true
ENABLE_PFMS_RECONCILIATION_WORKER=true
OUTBOX_WORKER_ENABLED=true
SLA_MONITOR_WORKER_ENABLED=true
DRIFT_MONITOR_WORKER_ENABLED=true
# Cutover gate requires these ISO timestamps to be refreshed by the live workers.
OUTBOX_WORKER_HEARTBEAT_AT=2026-01-01T00:00:00.000Z
SLA_WORKER_HEARTBEAT_AT=2026-01-01T00:00:00.000Z
RECONCILIATION_WORKER_HEARTBEAT_AT=2026-01-01T00:00:00.000Z
OUTBOX_WORKER_POLL_INTERVAL_MS=5000
OUTBOX_WORKER_BATCH_SIZE=50
OUTBOX_WORKER_MAX_RETRIES=5
SLA_MONITOR_POLL_INTERVAL_MS=60000
DRIFT_MONITOR_POLL_INTERVAL_MS=300000

# ----------------------------------------------------------------------------
# OBSERVABILITY [RECOMMENDED]
# ----------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=https://<otel-collector>/v1/traces
OTEL_SERVICE_NAME=vasa-eos-se-tn
SENTRY_DSN=https://<public-key>@<org>.ingest.sentry.io/<project>
LOG_LEVEL=info
METRICS_AUTH_TOKEN=<metrics-read-token>

# ----------------------------------------------------------------------------
# SECURITY / OPERATOR CONTROLS [RECOMMENDED]
# ----------------------------------------------------------------------------
ENCRYPTION_MASTER_KEY=<base64-32-byte-master-key>
AUDIT_SIGNING_KEY=<audit-signing-key-or-kms-key-ref>
CUTOVER_SHARED_SECRET=<deploy-verifier-shared-secret>
MIGRATIONS_FULLY_APPLIED=false
VAULT_ADDR=https://<sovereign-vault>
# KMS_KEY_URI or SOVEREIGN_KMS_KEY_URI may be used instead of VAULT_ADDR.
KMS_KEY_URI=<kms-key-uri>
SOVEREIGN_KMS_KEY_URI=<sovereign-kms-key-uri>
AUDIT_SINK_WRITABLE=false
PUBLIC_BASE_URL=https://<platform-domain>

# ----------------------------------------------------------------------------
# FEATURE FLAGS [OPTIONAL]
# ----------------------------------------------------------------------------
ENABLE_OFFLINE_WRITES=false
ENABLE_ML_FAIRNESS_MONITORING=false
